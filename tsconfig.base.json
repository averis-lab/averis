{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "paths": {
      // The web app's own alias, so tests that import its server-side modules
      // type-check against the real types rather than silently against `any`.
      "@/*": ["./apps/web/*"],
      "@averis/types": ["./packages/types/src/index.ts"],
      "@averis/types/*": ["./packages/types/src/*"],
      "@averis/db": ["./packages/db/src/index.ts"],
      "@averis/db/*": ["./packages/db/src/*"],
      "@averis/tracing": ["./packages/tracing/src/index.ts"],
      "@averis/tracing/*": ["./packages/tracing/src/*"],
      "@averis/queue": ["./packages/queue/src/index.ts"],
      "@averis/queue/*": ["./packages/queue/src/*"],
      "@averis/reppo-adapter": ["./packages/reppo-adapter/src/index.ts"],
      "@averis/reppo-adapter/*": ["./packages/reppo-adapter/src/*"],
      "@averis/agent-runtime": ["./packages/agent-runtime/src/index.ts"],
      "@averis/agent-runtime/*": ["./packages/agent-runtime/src/*"],
      "@averis/consensus": ["./packages/consensus/src/index.ts"],
      "@averis/consensus/*": ["./packages/consensus/src/*"],
      "@averis/reputation": ["./packages/reputation/src/index.ts"],
      "@averis/reputation/*": ["./packages/reputation/src/*"],
      "@averis/strategy": ["./packages/strategy/src/index.ts"],
      "@averis/strategy/*": ["./packages/strategy/src/*"],
      "@averis/budget": ["./packages/budget/src/index.ts"],
      "@averis/budget/*": ["./packages/budget/src/*"],
      "@averis/execution": ["./packages/execution/src/index.ts"],
      "@averis/execution/*": ["./packages/execution/src/*"],
      "@averis/protocol": ["./packages/protocol/src/index.ts"],
      "@averis/protocol/*": ["./packages/protocol/src/*"],
      "@averis/sdk": ["./packages/sdk/src/index.ts"],
      "@averis/sdk/*": ["./packages/sdk/src/*"]
    }
  }
}
